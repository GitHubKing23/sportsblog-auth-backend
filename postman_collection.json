{
  "info": {
    "_postman_id": "c70eaf11-5e8f-4e95-9d65-000000000001",
    "name": "Sportsblog Auth - Email + ArangoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection to exercise the email/password authentication flow backed by ArangoDB."
  },
  "item": [
    {
      "name": "1 - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{server_url}}/api/auth/register",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json.accessToken) pm.environment.set('accessToken', json.accessToken);",
              "if (json.refreshToken) pm.environment.set('refreshToken', json.refreshToken);",
              "if (json.user) {",
              "  pm.environment.set('userId', json.user.id || json.user._key || '');",
              "}",
              "console.log('Stored tokens from register response.');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{server_url}}/api/auth/login",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.accessToken) pm.environment.set('accessToken', json.accessToken);",
              "if (json.refreshToken) pm.environment.set('refreshToken', json.refreshToken);",
              "console.log('Stored tokens from login response.');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3 - Refresh Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{server_url}}/api/auth/refresh",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.accessToken) pm.environment.set('accessToken', json.accessToken);",
              "console.log('Refresh issued new access token.');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4 - Protected /me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{server_url}}/protected/me",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "protected",
            "me"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response contains user payload', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('user');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5 - Admin ping",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{server_url}}/protected/admin/ping",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "protected",
            "admin",
            "ping"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 for admin token', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "server_url", "value": "http://localhost:5000" },
    { "key": "email", "value": "user1@example.com" },
    { "key": "password", "value": "StrongPass123" },
    { "key": "name", "value": "First User" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" }
  ]
}
